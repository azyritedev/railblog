---
import type { GetStaticPaths } from "astro";
import PhotoGrid from "@/components/PhotoGrid.astro";
import Tag from "@/components/Tag.astro";
import Layout from "@/layouts/Layout.astro";
import { getEntry } from "astro:content";
import { getCollection } from "astro:content";

export const getStaticPaths = (async ({ paginate }) => {
  const tags = await getCollection("tags");
  const photos = await getCollection("photos");
  return tags.flatMap((t) => {
    const filteredPhotos = photos.filter((p) =>
      p.data.sidecar.tags.some((pt) => pt.id === t.id)
    );

    return paginate(filteredPhotos, {
      params: { tagid: t.id },
      pageSize: 16,
    });
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const params = Astro.params;

const tag = await getEntry("tags", params.tagid);
---

<Layout title={params.tagid} description={`Viewing the ${params.tagid} tag`}>
  <h1 class="text-3xl font-bold">
    Viewing <Tag class="inline-block" tag={params.tagid} /> tag
  </h1>
  <p>
    {tag?.data.description ?? "No description"}
  </p>
  <small>
    Page {page.currentPage} of {page.lastPage} (Showing items {page.start + 1}-{
      page.end + 1
    } of {page.total} photos)
  </small>
  <PhotoGrid filterFn={(photo) => page.data.some((p) => p.id === photo.id)} />
    <div class="bg-gray-300 p-4 text-lg mt-4 flex justify-center gap-2">
    <div class="inline-flex items-center gap-2">
      {
        new Array(page.lastPage).fill(null).map((_, i) => (
          <>
            {/* No link to the current page */}
            {i + 1 === page.currentPage ? (
              <span class="w-8 h-8 p-2 box-content inline-flex items-center justify-center border rounded bg-azyrite-blue text-white border-azyrite-blue">
                {page.currentPage}
              </span>
            ) : (
              <a
                href={`/gallery/all/${i + 1}`}
                class="w-8 h-8 p-2 box-content inline-flex items-center justify-center border rounded hover:bg-azyrite-blue/70 hover:border-azyrite-blue text-gray-900 hover:text-white transition-colors"
                aria-roledescription={`Go to page ${i + 1}`}
              >
                {" "}
                {i + 1}
              </a>
            )}
          </>
        ))
      }
    </div>
  </div>
</Layout>
