---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { Picture } from "astro:assets";
import Describe from "@/components/Describe.astro";
import Tag from "@/components/Tag.astro";
import { getImage } from "astro:assets";
import { getPhotoSrc } from "src/lib/loader/photos";
import { getEntry } from "astro:content";

export async function getStaticPaths() {
  const photos = await getCollection("photos");
  return photos.map((photo) => ({
    params: { photoid: photo.id },
    props: { photo },
  }));
}

const { photo } = Astro.props;

const photoSrc = getPhotoSrc(photo.data.path);
const photoData = (await photoSrc).default;

// Get photo for Open Graph
const ogPhoto = await getImage({
  src: photoData,
  quality: "low",
  densities: ["0.5x"],
});

// Find photos that list this one as "related" (i.e. backlinks)
const relatedPhotoIds = new Set<string>();
for (const related of photo.data.sidecar.related ?? []) {
  relatedPhotoIds.add(related.id);
}

const backLinkRelatedPhotos = await getCollection("photos").then((arr) =>
  arr.filter((p) => p.data.sidecar.related?.some((r) => r.id === photo.id))
);
for (const related of backLinkRelatedPhotos) {
  relatedPhotoIds.add(related.id);
}

const photoDate = photo.data.sidecar.date ?? photo.data.exif.date;

const author = await getEntry(photo.data.sidecar.author);
---

<Layout
  title={photo.data.sidecar.title}
  description={photo.data.sidecar.detail}
  og={{
    author: photo.data.sidecar.author.id,
    imagePath: ogPhoto.src,
    published: photoDate,
    title: photo.data.sidecar.title,
    description: photo.data.sidecar.detail,
  }}
>
  <main>
    <div class="w-full mb-2 flex-col flex items-center">
      <div class="xl:w-3/4 mb-1">
        <Picture
          alt={photo.data.sidecar.detail}
          src={photoSrc}
          formats={["jpg", "webp"]}
          loading="eager"
          layout="constrained"
          fit="scale-down"
          fetchpriority="high"
          class="object-scale-down max-h-screen"
        />
      </div>
      <p class="text-center">
        <small> Original size: {photoData.width}x{photoData.height}px</small>
      </p>
    </div>
    <div class="w-full flex flex-col items-center">
      <div class="xl:w-3/4">
        <p>Title</p>
        <h1 class="text-3xl font-extrabold">{photo.data.sidecar.title}</h1>

        <hr class="my-8" />

        <h2 class="text-lg mb-2 text-azyrite-blue">Description</h2>
        <p>{photo.data.sidecar.detail}</p>

        {
          photo.data.sidecar.notes && (
            <>
              <h2 class="text-lg mt-4 mb-2 text-azyrite-blue">
                Additional Notes
              </h2>
              <p>{photo.data.sidecar.notes}</p>
            </>
          )
        }

        <h2 class="text-lg mt-4 mb-2 text-azyrite-blue">Tags</h2>
        <div class="flex flex-wrap gap-2">
          {photo.data.sidecar.tags.map((t) => <Tag tag={t.id} />)}
        </div>

        <h2 class="text-lg mt-4 mb-2 text-azyrite-blue">Related Photos</h2>
        <p>
          {
            relatedPhotoIds.size
              ? `${relatedPhotoIds.size} related photo(s) found`
              : "No related photos found :("
          }
        </p>
        {
          relatedPhotoIds.size > 0 && (
            <ul class="list-disc ml-4">
              {Array.from(relatedPhotoIds).map((id) => (
                <li>
                  <a class="underline" href={`/gallery/${id}`}>
                    {id}
                  </a>
                </li>
              ))}
            </ul>
          )
        }

        <h2 class="text-lg mt-4 mb-2 text-azyrite-blue">Photographer</h2>
        <p><a class="underline" href={`/authors/${author.id}`}>{author.data.displayName}</a></p>

        <h2 class="text-lg mt-4 mb-2 text-azyrite-blue">Details</h2>
        <Describe
          descriptions={{
            Date: `${photoDate?.toString() ?? "No Date Found"} (${photoDate?.toISOString() ?? "No Date Found"})`,
            "Location (Approximate)":
              photo.data.sidecar.approxLocation ?? "Unspecified",
            Edited: (photo.data.sidecar.edited && "Yes") || "No",
            ID: photo.id,
          }}
        />

        <hr class="my-8" />

        <h2 class="text-lg mt-4 mb-2 text-azyrite-blue">Extracted EXIF</h2>
        {
          photo.data.exif && (
            <>
              <p class="text-sm mb-1">
                EXIF data found, but it may be incomplete. Coordinates are
                provided LAT/LON in the format found in EXIF data with no
                processing apart from truncation to 6 decimal places.
              </p>
              <Describe
                descriptions={{
                  "Camera Make": photo.data.exif.cameraMake ?? "Unknown",
                  "Camera Model":
                    photo.data.exif.cameraModel ?? "Unknown Model",
                  Aperture: photo.data.exif.aperture
                    ? `f/${photo.data.exif.aperture}`
                    : "Unknown",
                  ISO: photo.data.exif.iso?.toString() ?? "Unknown",
                  "Exposure Time": photo.data.exif.exposureTime
                    ? `1/${Math.round(1 / photo.data.exif.exposureTime)}sec`
                    : "Unknown",
                  Coordinates:
                    photo.data.exif.lat && photo.data.exif.lon
                      ? `${photo.data.exif.lat.toFixed(6)}, ${photo.data.exif.lon.toFixed(6)}`
                      : "No GPS data found",
                }}
              />
            </>
          )
        }
        {!photo.data.exif && <p class="text-sm">No EXIF data found :(</p>}
      </div>
    </div>
  </main>
</Layout>
