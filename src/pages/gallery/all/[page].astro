---
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import PhotoGrid from "@/components/PhotoGrid.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const photos = await getCollection("photos");

  return paginate(photos, {
    pageSize: 16,
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout title="All photos" description="Viewing all photos in the gallery">
  <h1 class="text-3xl font-bold">Viewing all photos in the gallery</h1>
  <small>
    Page {page.currentPage} of {page.lastPage} (Showing items {page.start + 1}-{
      page.end + 1
    } of {page.total} photos)
  </small>
  <div class="mt-4">
    <!-- PhotoGrid: Show only photos in this page -->
    <PhotoGrid filterFn={(photo) => page.data.some((p) => p.id === photo.id)} />
  </div>
  <div class="bg-gray-300 p-4 text-lg mt-4 flex justify-center gap-2">
    <div>
      <span>Page:</span>
    </div>
    {
      new Array(page.lastPage).fill(null).map((_, i) => (
        <div>
          {/* No link to the current page */}
          {i + 1 === page.currentPage ? (
            <span>{page.currentPage}</span>
          ) : (
            <a href={`/gallery/all/${i + 1}`} class="underline">
              {" "}
              {i + 1}
            </a>
          )}
        </div>
      ))
    }
  </div>
</Layout>
