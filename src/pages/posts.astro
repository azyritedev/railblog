---
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import { getCollection, getEntry } from "astro:content";

// Get posts sorted by recency
const posts = (await getCollection("posts"))
  .sort(
    (posta, postb) =>
      postb.data.published.getTime() - posta.data.published.getTime()
  )
  .filter((p) => !p.data.draft);
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/photos/*.jpg"
);
---

<Layout title="Posts">
  <header class="mb-2">
    <h1 class="text-3xl font-bold mb-2">Posts</h1>
    <p class="italic">Longer form text content and write-ups</p>
  </header>
  <div class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 mt-4">
    {
      posts.map(async (post) => {
        // HACK: Cooked way of obtaining photo src
        const photo = post.data.photo && (await getEntry(post.data.photo));
        const image = photo && images[photo.data.key];
        return (
          <div class="p-2 flex flex-col gap-2">
            {image && (
              <a href={`/posts/${post.id}`}>
                <Image
                  src={image()}
                  alt={photo.data.meta.detail}
                  layout="constrained"
                />
              </a>
            )}
            <div class="mt-2">
              <h2 class="text-xl font-bold">
                <a href={`/posts/${post.id}`} class="hover:underline">
                  {post.data.title}
                </a>
              </h2>
              <small>
                {post.data.published.toDateString()} by {post.data.author.id}
              </small>
              <p class="mt-1">{post.data.blurb}</p>
              <hr class="mt-4 text-gray-300" />
            </div>
          </div>
        );
      })
    }
  </div>
</Layout>
