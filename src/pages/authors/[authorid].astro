---
import PhotoGrid from "@/components/PhotoGrid.astro";
import Layout from "@/layouts/Layout.astro";
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";

export const getStaticPaths = (async () => {
  const authors = await getCollection("authors");

  return authors.map((author) => ({
    params: { authorid: author.id },
    props: { author },
  }));
}) satisfies GetStaticPaths;

const { author } = Astro.props;

const attributablePhotos = await getCollection("photos").then(
  (photos) =>
    photos.filter((photo) => photo.data.sidecar.author.id === author.id).length
);
const attributablePosts = await getCollection("posts").then(
  (posts) => posts.filter((post) => post.data.author.id === author.id).length
);

const featuredPhotos = author.data.featuredPhotos;
---

<Layout
  title={author.data.displayName}
  description={`Profile page for ${author.data.displayName}`}
>
  <div class="flex flex-col items-center gap-8">
    <div class="xl:w-1/2">
      <p>Photographer Profile</p>
      <h1 class="text-3xl font-extrabold">{author.data.displayName}</h1>
      <p class="text-gray-700">
        <b>{attributablePhotos}</b> photo{attributablePhotos !== 1 && "s"} and <b
          >{attributablePosts}</b
        > post{attributablePosts !== 1 && "s"} contributed
      </p>
      <hr class="my-8" />
      <h2 class="text-lg mt-4 mb-2 text-azyrite-blue">Contact Email</h2>
      {
        author.data.email ? (
          <p>
            <a class="underline" href={`mailto:${author.data.email}`}>
              {author.data.email}
            </a>
          </p>
        ) : (
          <p>
            No email address available, please see{" "}
            <a href="/about">About & Contact</a> for inquiries
          </p>
        )
      }
      <hr class="my-8" />
      <h2 class="text-lg mt-4 mb-2 text-azyrite-blue">Featured Photographs</h2>
      <p>
        {author.data.displayName} has selected <b>{featuredPhotos.length}</b> featured
        photo{featuredPhotos.length !== 1 && "s"} to display on their profile.
      </p>
    </div>
    <div class="md:w-5/6">
      <PhotoGrid
        hideInfos
        filterFn={(photo) => featuredPhotos.some((p) => p.id === photo.id)}
      />
    </div>
  </div>
</Layout>
