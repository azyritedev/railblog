---
import Layout from "../layouts/Layout.astro";
import featuredImage from "../content/photos/5x7_MG_5641.jpg";
import { Image } from "astro:assets";
---

<Layout>
  <div class="prose">
    <h1>Welcome to azyrite's rail blog!</h1>
    <p>
      Hello there! Welcome to my rail blog and gallery. <b
        >This site is still very much a work in progress!</b
      > If you're looking for the photos, check out the <a href="/gallery"
        >gallery</a
      >.
    </p>
    <p>
      <b>You can now view a listing of all photos</b>
      <a href="/gallery/all/1">here</a>!
    </p>
    <hr />
    <p>Here's a cool image I got recently:</p>
    <figure>
      <Image
        src={featuredImage}
        layout="constrained"
        alt="The featured image"
        loading="eager"
        width={700}
        height={500}
      />
      <figcaption>Featured Image — B set at Penrith on the down</figcaption>
    </figure>
  </div>
</Layout>
