---
import Layout from "../layouts/Layout.astro";
import galleryImage from "../content/photos/5x7_MG_5641.jpg";
import galleryAllImage from "../content/photos/_MG_5731.jpg";
import aboutImage from "../content/photos/_MG_5763.jpg";
import heroImage from "../content/photos/16x10_MG_5342.jpg";
import { Image } from "astro:assets";
---

<Layout title="Home">
  <!-- Hero -->
  <div class="-mx-4 relative">
    <Image
      src={heroImage}
      priority
      alt=""
      class="h-[65vh] object-cover brightness-50"
    />
    <div class="absolute left-8 bottom-8">
      <h1 class="text-7xl lg:text-8xl font-black text-white leading-snug">
        azyrite's rail blog
      </h1>
      <p class="text-xl md:text-2xl italic font-bold text-white">
        photos of NSW trains & infrastructure
      </p>
    </div>
  </div>

  <div
    class="container mx-auto grid grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-8 mt-8"
  >
    <a
      href="/gallery"
      class="hover:opacity-75 transition-opacity ease-out duration-150"
    >
      <div class="relative h-full">
        <Image
          src={galleryImage}
          loading="eager"
          alt=""
          class="object-cover brightness-50"
        />
        <div class="absolute right-4 bottom-4">
          <h2 class="text-2xl font-bold text-white">Gallery</h2>
        </div>
      </div></a
    >
    <a
      href="/gallery/all/1"
      class="hover:opacity-75 transition-opacity ease-out duration-150"
    >
      <div class="relative h-full">
        <Image
          src={galleryAllImage}
          alt=""
          loading="eager"
          class="object-cover h-full brightness-50"
        />
        <div class="absolute right-4 bottom-4">
          <h2 class="text-2xl font-bold text-white">All Images</h2>
        </div>
      </div></a
    >
    <a
      href="/about"
      class="hover:opacity-75 transition-opacity ease-out duration-150"
    >
      <div class="relative h-full">
        <Image
          src={aboutImage}
          alt=""
          loading="eager"
          class="h-full object-cover brightness-50"
        />
        <div class="absolute right-4 bottom-4">
          <h2 class="text-2xl font-bold text-white">About</h2>
        </div>
      </div></a
    >
  </div>
</Layout>
