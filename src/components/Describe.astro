---

interface Props {
  descriptions: { [k: string]: string | number };
}

const { descriptions } = Astro.props;
---

<dl>
  {
    Object.entries(descriptions).map(([key, value]) => (
        <dt class="p-1 w-1/4 font-bold float-left">{key}</dt>
        <dd class="p-1 ml-[35%] after:clear-both after:block">{value}</dd>
    ))
  }
</dl>
