---

interface Props {
  descriptions: { [k: string]: string | number };
}

const { descriptions } = Astro.props;
---

<dl>
  {
    Object.entries(descriptions).map(([key, value]) => (
        <dt class="pb-1 w-1/4 font-bold float-left">{key}</dt>
        <dd class="pb-1 ml-4">{value}</dd>
    ))
  }
</dl>
