---
interface Props {
  title: string;
  published?: Date;
  description?: string;
  author: string;
  imagePath: string;
}

const props = Astro.props;
---

<meta property="og:title" content={props.title} />
{
  props.description && (
    <meta property="og:description" content={props.description} />
  )
}
<meta property="og:type" content="article" />
{
  props.published && (
    <meta
      property="article:published_time"
      content={props.published.toISOString()}
    />
  )
}
<meta property="article:author" content={props.author} />
<meta property="og:image" content={new URL(props.imagePath, Astro.site)} />
<meta property="og:url" content={Astro.url} />

<!-- Open Graph - Static properties -->
<meta property="og:site_name" content="azyrite's rail blog" />
<meta name="twitter:card" content="summary_large_image" /> 